BASE_URL=https://www.automationexercise.com

# There is deliberately no test-user credential here.
# Specs seed their own account per test via POST /api/createAccount and delete it in
# teardown — see openspec/project.md § "Conventions that are not negotiable".
# A shared account on a public site can be deleted by any other run, which is how a
# real regression turns into a skip.
